rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validHome(homeId) {
      return homeId.matches('^[a-f0-9]{24}$');
    }
    function member(homeId) {
      return signedIn() && exists(/databases/$(database)/documents/homes/$(homeId)/profiles/$(request.auth.uid));
    }
    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','skin','hair','hairColor','shirt'])
        && d.keys().hasAll(['name','skin','hair','hairColor','shirt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 12
        && d.hair in ['korean','long','cap']
        && d.skin is string && d.skin.matches('^#[a-fA-F0-9]{6}$')
        && d.hairColor is string && d.hairColor.matches('^#[a-fA-F0-9]{6}$')
        && d.shirt is string && d.shirt.matches('^#[a-fA-F0-9]{6}$');
    }
    match /homes/{homeId} {
      allow get: if signedIn() && validHome(homeId);
      allow list: if false;
      allow create: if signedIn() && validHome(homeId)
        && request.resource.data.keys().hasOnly(['ownerUid','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
      match /profiles/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || member(homeId));
        allow list: if member(homeId);
        allow create, update: if signedIn() && validHome(homeId)
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/homes/$(homeId))
          && validProfile();
        allow delete: if false;
      }
      match /settings/tasks {
        allow read: if member(homeId);
        allow create, update: if member(homeId)
          && request.resource.data.keys().hasOnly(['items'])
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.items.size() <= 30;
        allow delete: if false;
      }
      match /days/{day}/claims/{taskId} {
        allow read: if member(homeId);
        allow create: if member(homeId)
          && day == string(math.floor(request.time.toMillis() / 1800000))
          && request.resource.data.keys().hasOnly(['uid','name','at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 12
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }
  }
}
