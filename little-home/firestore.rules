rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /homes/{homeId}/settings/tasks {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 30;
    }
    match /homes/{homeId}/profiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','skin','hair','hairColor','shirt']);
      allow delete: if false;
    }
    match /homes/{homeId}/days/{hour}/claims/{taskId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && hour == string(math.floor(request.time.toMillis() / 3600000))
        && request.resource.data.keys().hasOnly(['uid','name','at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 12
        && request.resource.data.at == request.time
        && !exists(/databases/$(database)/documents/homes/$(homeId)/days/$(hour)/claims/$(taskId));
      allow update, delete: if false;
    }
  }
}
